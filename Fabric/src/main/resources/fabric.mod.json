{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",

  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "Vazkii",
    "williewillus"
  ],
  "contributors": [
    "gabmaybelle (26.3 port)"
  ],
  "contact": {
    "issues": "https://github.com/gabmaybelle/patchouli/issues",
    "sources": "https://github.com/gabmaybelle/patchouli"
  },

  "license": "CC BY-NC-SA 3.0",
  "icon": "assets/patchouli/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "vazkii.patchouli.fabric.common.FabricModInitializer"
    ],
    "client": [
      "vazkii.patchouli.fabric.client.FabricClientInitializer"
    ],
    "fabric-gametest": [
      "vazkii.patchouli.fabric.common.PatchouliSmokeTest"
    ]
  },
  "mixins": [
    "patchouli_xplat.mixins.json",
    "patchouli_fabric.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": ">=${mc_min_version} <${mc_max_version}"
  }
}
